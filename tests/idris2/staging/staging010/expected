-- type: Int -> List Int -> Maybe Int
-- data List #0 = Nil | (::) #0 List #0
-- data Maybe #0 = Nothing | Just #0
\n : Int, xs : List Int =>
  letrec
    go : List Int -> Maybe Int = \l : List Int =>
        case l of
          [] => Nothing
          x :: r => case n < x of
              0 => go r
              _ => Just x
  in go xs

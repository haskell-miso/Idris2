||| Closure-free two-level type theory (Kovács, "Closure-Free Functional
||| Programming in a Two-Level Type Theory", ICFP 2024): low code.
|||
|||   Low a       the meta level type of closure free object code of type a
|||
||| Quotations [|| e ||] and splices ~e are shared with Code (Language.Staged):
||| a quotation is low code when its type is Low t.  Low code is a first
||| order, strict, monomorphic subset of Idris:
|||
|||  * values have value types: the primitive types, and data types whose
|||    fields are value types (no functions in data);
|||  * functions are first order: their arguments are values, so no closures
|||    are ever needed at run time;
|||  * let bound values and function arguments are evaluated (call by value);
|||  * global functions are inlined (a recursive one becomes a local recursive
|||    function), so they must be first order too; constructors, primitives
|||    and local definitions are used as they are.
|||
||| Low code is generated by ordinary (meta level) Idris code, which can use
||| all of Idris.  Spliced into object code, low code runs as ordinary code.
||| With reflect, the generated code is a first order syntax tree (LowProg),
||| with the type of every binder, for user written code generators (see
||| Language.Staged.Low.C).
|||
||| A type variable in low code stands for a value type: a generator that is
||| polymorphic in a type that is used in low code needs a (LowRep a)
||| constraint, which the compiler solves for every concrete type.
module Language.Staged.Low

import Data.List
import Data.Maybe
import Data.String
import public Language.Staged.Code

%default covering

--------------------------------------------------------------------------
-- The representation of low code (built by the code that the compiler
-- generates for a Low quotation; the names and constructors are known to
-- the compiler, in TTImp.LowQuote and TTImp.Unstage)

mutual
  ||| The types of low code
  public export
  data LowTy : Type where
       TInt : LowTy
       TInteger : LowTy
       TInt8 : LowTy
       TInt16 : LowTy
       TInt32 : LowTy
       TInt64 : LowTy
       TBits8 : LowTy
       TBits16 : LowTy
       TBits32 : LowTy
       TBits64 : LowTy
       TDouble : LowTy
       TChar : LowTy
       TString : LowTy
       ||| A first order function type (a computation type)
       TFun : List LowTy -> LowTy -> LowTy
       ||| A data type: its name, type arguments, and declaration
       TData : String -> List LowTy -> Lazy LowDecl -> LowTy
       ||| A type parameter, only in the field types of a LowDecl
       TParam : Nat -> LowTy
       ||| A type that low code cannot handle
       TOther : String -> LowTy

  ||| The declaration of a data type.  The field types refer to the
  ||| parameters with TParam.
  public export
  record LowDecl where
    constructor MkLowDecl
    declName : String
    declArity : Nat
    declNewtype : Bool
    declCons : List LowConDecl

  ||| A constructor of a data type: its run time fields (types and erased
  ||| arguments are not fields)
  public export
  record LowConDecl where
    constructor MkLowConDecl
    conDeclName : String
    conDeclTag : Int
    conDeclFields : List LowTy

||| A constructor as used in code: name, tag (its number among the
||| constructors of the type), arity (of run time fields), newtype
public export
record LowCon where
  constructor MkLowCon
  conName : String
  conTag : Int
  conArity : Nat
  conNewtype : Bool

public export
data LowLit = LitInt Int | LitInteger Integer | LitDouble Double
            | LitChar Char | LitString String
            | ||| A literal of a fixed width type (Int8 .. Bits64)
              LitFixed LowTy Integer

mutual
  ||| Low code, with higher order abstract syntax binders, as built by the
  ||| code that the compiler generates for a Low quotation.  The type of a
  ||| variable is recorded where it is bound; the types of the others are
  ||| found by reflect.
  public export
  data LowExp : Type where
       ||| A variable bound in low code, during the read back (the level is -1)
       HVar : Int -> String -> LowTy -> LowExp
       ||| An object level variable from outside the low code (an argument of
       ||| the definition that the low code is spliced into)
       HObj : String -> LowTy -> {0 a : Type} -> a -> LowExp
       HLam : String -> LowTy -> (LowExp -> LowExp) -> LowExp
       HApp : LowExp -> List LowExp -> LowExp
       HLet : String -> Maybe LowTy -> LowExp -> (LowExp -> LowExp) -> LowExp
       HLetRec : List (String, LowTy) -> (List LowExp -> (List LowExp, LowExp)) -> LowExp
       ||| A case on a value of a data type: the scrutinee, all the
       ||| constructors of its type, the alternatives, the default
       HCase : LowExp -> List LowCon -> List LowAlt -> Maybe LowExp -> LowExp
       ||| A case on a primitive value: the scrutinee, the alternatives for
       ||| literals, the default
       HCaseLit : LowExp -> List (LowLit, LowExp) -> LowExp -> LowExp
       ||| A constructor application; the type is the (function) type of the
       ||| constructor
       HCon : LowCon -> LowTy -> List LowExp -> LowExp
       HLit : LowLit -> LowTy -> LowExp
       ||| A primitive of the runtime system, e.g. prim__add_Int
       HPrim : String -> LowTy -> LowExp
       ||| A foreign function: the Idris name, and the C function
       HForeign : String -> String -> LowTy -> LowExp
       ||| A failed pattern match, or an error
       HFail : String -> LowExp

  public export
  data LowAlt : Type where
       MkLowAlt : LowCon -> List String -> (List LowExp -> LowExp) -> LowAlt

||| The meta level type of closure free object code of type a
public export
record Low (a : Type) where
  constructor MkLow
  unLow : LowExp

||| The representation of a type in low code.  The compiler solves LowRep t
||| for every concrete type t; a type variable used in low code needs a
||| LowRep constraint.
public export
record LowRep (0 a : Type) where
  constructor MkLowRep
  lowTyRep : LowTy

||| The low type of a type
public export
lowTyOf : (0 a : Type) -> LowRep a => LowTy
lowTyOf a @{r} = lowTyRep r

||| The representation of low code (used by the code the compiler generates)
public export
lowExpOf : (0 a : Type) -> Low a -> LowExp
lowExpOf _ (MkLow e) = e

||| The low type of a representation (used by the code the compiler generates)
public export
lowTyOfRep : (0 a : Type) -> LowRep a -> LowTy
lowTyOfRep _ (MkLowRep t) = t

||| A quotation of closure free code: made by the elaborator for a quotation
||| [|| e ||] whose type is Low t, and translated by the compiler to the
||| code that builds the representation of e (it is never run)
export
lowQuote : (0 a : Type) -> Code a -> Low a
lowQuote _ _ = MkLow (HFail "a quotation of low code that was not translated")

||| The n-th of the variables bound by a case alternative or recursive let
||| (used by the code the compiler generates for low code)
export
lowNth : Nat -> List LowExp -> LowExp
lowNth _ [] = HFail "lowNth"
lowNth Z (x :: _) = x
lowNth (S k) (_ :: xs) = lowNth k xs

--------------------------------------------------------------------------
-- Basic operations on types

||| The name without the namespace
export
baseName : String -> String
baseName s
    = case break (== '.') (unpack s) of
           (m, '.' :: r) =>
               if not (null m) && all (\c => c /= '(' && c /= '[') m && not (null r)
                  then baseName (pack r)
                  else s
           _ => s

mutual
  eqTy : LowTy -> LowTy -> Bool
  eqTy TInt TInt = True
  eqTy TInteger TInteger = True
  eqTy TInt8 TInt8 = True
  eqTy TInt16 TInt16 = True
  eqTy TInt32 TInt32 = True
  eqTy TInt64 TInt64 = True
  eqTy TBits8 TBits8 = True
  eqTy TBits16 TBits16 = True
  eqTy TBits32 TBits32 = True
  eqTy TBits64 TBits64 = True
  eqTy TDouble TDouble = True
  eqTy TChar TChar = True
  eqTy TString TString = True
  eqTy (TFun as r) (TFun bs s) = eqList as bs && eqTy r s
  eqTy (TData n as _) (TData m bs _) = n == m && eqList as bs
  eqTy (TParam i) (TParam j) = i == j
  eqTy (TOther s) (TOther t) = s == t
  eqTy _ _ = False

  eqList : List LowTy -> List LowTy -> Bool
  eqList [] [] = True
  eqList (x :: xs) (y :: ys) = eqTy x y && eqList xs ys
  eqList _ _ = False

export
Eq LowTy where
  x == y = assert_total (eqTy x y)

isTupleName : String -> Bool
isTupleName n = n == "MkPair"

showTy : Prec -> LowTy -> String
showTy d t
    = case t of
           TInt => "Int"
           TInteger => "Integer"
           TInt8 => "Int8"
           TInt16 => "Int16"
           TInt32 => "Int32"
           TInt64 => "Int64"
           TBits8 => "Bits8"
           TBits16 => "Bits16"
           TBits32 => "Bits32"
           TBits64 => "Bits64"
           TDouble => "Double"
           TChar => "Char"
           TString => "String"
           TFun as r => showParens (d > Open) $
                          concatMap (\a => showTy App a ++ " -> ") as ++ showTy Open r
           TData n [a] _ => if baseName n == "List"
                               then "List " ++ showTy App a
                               else showParens (d >= App) (baseName n ++ " " ++ showTy App a)
           TData n [a, b] _ => if baseName n == "Pair"
                                  then "(" ++ showTy Open a ++ ", " ++ showTy Open b ++ ")"
                                  else showParens (d >= App) (baseName n ++ " " ++ showTy App a ++ " " ++ showTy App b)
           TData n [] _ => baseName n
           TData n as _ => showParens (d >= App) $
                             baseName n ++ concatMap (\a => " " ++ showTy App a) as
           TParam i => "#" ++ show i
           TOther s => "{" ++ s ++ "}"

showDecl : LowDecl -> String
showDecl (MkLowDecl n a nt cs)
      = (if nt then "newtype " else "data ") ++ baseName n ++
        concatMap (\i => " #" ++ show i) (take a [0 .. a]) ++ " = " ++
        joinBy " | " [ baseName (conDeclName c) ++
                       concatMap (\f => " " ++ showTy App f) (conDeclFields c)
                     | c <- cs ]

||| The declaration is not shown, since it can be recursive
export
Show LowTy where
  showPrec d t = assert_total (showTy d t)

export
Show LowDecl where
  show d = assert_total (showDecl d)

export
Show LowCon where
  show c = conName c

export
Eq LowCon where
  a == b = conName a == conName b

export
Show LowLit where
  show (LitInt i) = show i
  show (LitInteger i) = show i
  show (LitDouble d) = show d
  show (LitChar c) = show c
  show (LitString s) = show s
  show (LitFixed _ i) = show i

export
Eq LowLit where
  LitInt a == LitInt b = a == b
  LitInteger a == LitInteger b = a == b
  LitDouble a == LitDouble b = a == b
  LitChar a == LitChar b = a == b
  LitString a == LitString b = a == b
  LitFixed t a == LitFixed u b = t == u && a == b
  _ == _ = False

--------------------------------------------------------------------------
-- First order low code: the result of reflect

||| Variables are named uniquely in a program; every binder carries its type
public export
data LowTerm : Type where
     ||| A variable, with its type
     LVar : String -> LowTy -> LowTerm
     LLit : LowLit -> LowTy -> LowTerm
     ||| A primitive of the runtime system, with its type
     LPrim : String -> LowTy -> LowTerm
     ||| A foreign (C) function: Idris name, C name, type
     LForeign : String -> String -> LowTy -> LowTerm
     ||| A saturated call of a variable, primitive, or foreign function
     LApp : LowTerm -> List LowTerm -> LowTerm
     ||| A function; only as the right hand side of a let, or the program
     LLam : List (String, LowTy) -> LowTerm -> LowTerm
     ||| let x : t = e in b  (e is evaluated first, unless it is a function)
     LLet : String -> LowTy -> LowTerm -> LowTerm -> LowTerm
     ||| Recursive functions
     LLetRec : List (String, LowTy, LowTerm) -> LowTerm -> LowTerm
     ||| The scrutinee, all constructors of its type, alternatives, default
     LCase : LowTerm -> List LowCon -> List (LowCon, List (String, LowTy), LowTerm) ->
             Maybe LowTerm -> LowTerm
     ||| A case on a primitive value: scrutinee, alternatives, default
     LCaseLit : LowTerm -> List (LowLit, LowTerm) -> LowTerm -> LowTerm
     ||| A saturated constructor application; the type of the value
     LCon : LowCon -> LowTy -> List LowTerm -> LowTerm
     ||| A failed pattern match or error
     LFail : String -> LowTerm

public export
record LowProg where
  constructor MkLowProg
  ||| The type of the program
  progType : LowTy
  ||| The free (object level) variables
  progFree : List (String, LowTy)
  ||| The data types used
  progDecls : List LowDecl
  progBody : LowTerm

||| The number of arguments of a function type
export
arity : LowTy -> Nat
arity (TFun as _) = length as
arity _ = 0

||| The result type of a function type
export
resultType : LowTy -> LowTy
resultType (TFun _ r) = r
resultType t = t

export
applyTy : LowTy -> Nat -> LowTy
applyTy t Z = t
applyTy (TFun as r) n
    = if n < length as then TFun (drop n as) r
      else if n == length as then r
      else applyTy r (minus n (length as))
applyTy _ _ = TOther "application of a non-function"

mkFun : List LowTy -> LowTy -> LowTy
mkFun [] r = r
mkFun as (TFun bs r) = TFun (as ++ bs) r
mkFun as r = TFun as r

||| The type of a term
export
typeOf : LowTerm -> LowTy
typeOf (LVar _ t) = t
typeOf (LLit _ t) = t
typeOf (LPrim _ t) = t
typeOf (LForeign _ _ t) = t
typeOf (LApp f as) = applyTy (typeOf f) (length as)
typeOf (LLam xs b) = mkFun (map snd xs) (typeOf b)
typeOf (LLet _ _ _ b) = typeOf b
typeOf (LLetRec _ b) = typeOf b
typeOf (LCase _ _ ((_, _, b) :: _) _) = typeOf b
typeOf (LCase _ _ [] (Just d)) = typeOf d
typeOf (LCase _ _ [] Nothing) = TOther "empty case"
typeOf (LCaseLit _ ((_, b) :: _) _) = typeOf b
typeOf (LCaseLit _ [] d) = typeOf d
typeOf (LCon _ t _) = t
typeOf (LFail _) = TOther "fail"

substParams : List LowTy -> LowTy -> LowTy
substParams args (TParam i) = fromMaybe (TParam i) (getAt i args)
substParams args (TFun as r) = TFun (map (substParams args) as) (substParams args r)
substParams args (TData n as d) = TData n (map (substParams args) as) d
substParams args t = t

||| The field types of a constructor of a data type, with the type arguments
||| substituted
export
conFieldTypes : LowTy -> LowCon -> List LowTy
conFieldTypes (TData _ args decl) con
    = case [ conDeclFields c | c <- declCons decl, conDeclTag c == conTag con ] of
           fs :: _ => map (substParams args) fs
           [] => []
conFieldTypes _ _ = []

||| All the variable names of a term (bound and free), for code generators
||| that make up names of their own
export
varNames : LowTerm -> List String
varNames (LVar x _) = [x]
varNames (LApp f as) = varNames f ++ concatMap varNames as
varNames (LLam xs b) = map fst xs ++ varNames b
varNames (LLet x _ e b) = x :: varNames e ++ varNames b
varNames (LLetRec bs b) = concatMap (\(x, _, e) => x :: varNames e) bs ++ varNames b
varNames (LCase s _ alts d)
    = varNames s ++ concatMap (\(_, xs, b) => map fst xs ++ varNames b) alts ++
      maybe [] varNames d
varNames (LCaseLit s alts d) = varNames s ++ concatMap (varNames . snd) alts ++ varNames d
varNames (LCon _ _ as) = concatMap varNames as
varNames _ = []

||| The free variables of a term
export
freeVars : LowTerm -> List (String, LowTy)
freeVars = nubBy (\a, b => fst a == fst b) . go []
  where
    go : List String -> LowTerm -> List (String, LowTy)
    go bound (LVar x t) = if x `elem` bound then [] else [(x, t)]
    go bound (LApp f as) = go bound f ++ concatMap (go bound) as
    go bound (LLam xs b) = go (map fst xs ++ bound) b
    go bound (LLet x _ e b) = go bound e ++ go (x :: bound) b
    go bound (LLetRec bs b)
        = let bound' = map (\(x, _, _) => x) bs ++ bound in
              concatMap (\(_, _, e) => go bound' e) bs ++ go bound' b
    go bound (LCase s _ alts d)
        = go bound s ++ concatMap (\(_, xs, b) => go (map fst xs ++ bound) b) alts ++
          maybe [] (go bound) d
    go bound (LCaseLit s alts d) = go bound s ++ concatMap (go bound . snd) alts ++ go bound d
    go bound (LCon _ _ as) = concatMap (go bound) as
    go bound _ = []

--------------------------------------------------------------------------
-- Reflection: read back the HOAS representation as first order terms

-- A small state monad: the names in use, and the free variables
record RS where
  constructor MkRS
  used : List String
  free : List (String, String, LowTy)    -- source name, name, type

record R a where
  constructor MkR
  runR : RS -> (a, RS)

Functor R where
  map f (MkR g) = MkR $ \s => let (a, s') = g s in (f a, s')

Applicative R where
  pure a = MkR $ \s => (a, s)
  MkR f <*> MkR a = MkR $ \s => let (g, s') = f s
                                    (b, s'') = a s' in (g b, s'')

Monad R where
  MkR g >>= f = MkR $ \s => let (a, s') = g s in runR (f a) s'

isLowerStart : List Char -> Bool
isLowerStart (c :: _) = isLower c || c == '_'
isLowerStart [] = False

-- A fresh variable name, based on the name in the source
fresh : String -> R String
fresh s = MkR $ \st =>
    let b = pack (takeWhile (\c => isAlphaNum c || c == '_' || c == '\'') (unpack s))
        base = if isLowerStart (unpack b) then b else "v"
        name = pick base (used st) 1
    in (name, { used $= (name ::) } st)
  where
    pick : String -> List String -> Nat -> String
    pick base us i
        = let n = if i == 1 then base else base ++ "_" ++ show (minus i 1) in
              if n `elem` us then assert_total (pick base us (S i)) else n

-- The name of a free (object level) variable
freeVar : String -> LowTy -> R String
freeVar x t = MkR $ \st =>
    case [ n | (x', n, _) <- free st, x' == x ] of
         n :: _ => (n, st)
         [] => let (n, st') = runR (fresh x) st in
                   (n, { free $= (++ [(x, n, t)]) } st')

boundLevel : Int
boundLevel = -1

readBack : LowExp -> R LowTerm
readBack (HVar l x t) = pure (LVar x t)
readBack (HObj x t _) = do n <- freeVar x t
                           pure (LVar n t)
readBack (HLam x t f)
    = do x' <- fresh x
         b <- readBack (f (HVar boundLevel x' t))
         pure (LLam [(x', t)] b)
readBack (HApp f as) = [| LApp (readBack f) (traverse readBack as) |]
readBack (HLet x mt e f)
    = do e' <- readBack e
         let t = fromMaybe (typeOf e') mt
         x' <- fresh x
         b <- readBack (f (HVar boundLevel x' t))
         pure (LLet x' t e' b)
readBack (HLetRec xts f)
    = do xs <- traverse (fresh . fst) xts
         let ts = map snd xts
         let (es, b) = f (zipWith (HVar boundLevel) xs ts)
         es' <- traverse readBack es
         b' <- readBack b
         pure (LLetRec (zip3 xs ts es') b')
readBack (HCase s cons alts d)
    = do s' <- readBack s
         let st = typeOf s'
         alts' <- traverse (alt st) alts
         d' <- traverse readBack d
         pure (LCase s' cons alts' d')
  where
    alt : LowTy -> LowAlt -> R (LowCon, List (String, LowTy), LowTerm)
    alt st (MkLowAlt con names f)
        = do xs <- traverse fresh names
             let ts = conFieldTypes st con
             let ts' = ts ++ replicate (minus (length xs) (length ts)) (TOther "unknown field type")
             b <- readBack (f (zipWith (HVar boundLevel) xs ts'))
             pure (con, zip xs ts', b)
readBack (HCaseLit s alts d)
    = do s' <- readBack s
         alts' <- traverse (\(l, e) => map (\e' => (l, e')) (readBack e)) alts
         d' <- readBack d
         pure (LCaseLit s' alts' d')
readBack (HCon c t as) = LCon c (applyTy t (length as)) <$> traverse readBack as
readBack (HLit l t) = pure (LLit l t)
readBack (HPrim p t) = pure (LPrim p t)
readBack (HForeign h c t) = pure (LForeign h c t)
readBack (HFail m) = pure (LFail m)

-- Call saturation: afterwards every call (LApp) has as many arguments as the
-- function type has, every constructor application is saturated, and
-- functions (LLam) only occur as the right hand side of lets, or as the
-- whole program.  (Section 2.2 of the CFTT paper.)

mergeLam : List (String, LowTy) -> LowTerm -> LowTerm
mergeLam xs (LLam ys b) = LLam (xs ++ ys) b
mergeLam xs b = LLam xs b

bindArgs : List LowTerm -> (List LowTerm -> R LowTerm) -> R LowTerm
bindArgs as k = go [] as
  where
    go : List LowTerm -> List LowTerm -> R LowTerm
    go acc [] = k (reverse acc)
    go acc (a@(LVar _ _) :: rest) = go (a :: acc) rest
    go acc (a@(LLit _ _) :: rest) = go (a :: acc) rest
    go acc (a :: rest)
        = do x <- fresh "a"
             let t = typeOf a
             b <- go (LVar x t :: acc) rest
             pure (LLet x t a b)

-- Eta expand a partial application to a function
etaApp : LowTerm -> List LowTerm -> R LowTerm
etaApp f as
    = case applyTy (typeOf f) (length as) of
           TFun ps _ =>
              do vs <- traverse (const (fresh "x")) ps
                 let xs = zip vs ps
                 pure (LLam xs (LApp f (as ++ map (\(v, t) => LVar v t) xs)))
           _ => pure (LApp f as)

-- t is the type of the partial application
etaCon : LowCon -> LowTy -> List LowTerm -> R LowTerm
etaCon c t as
    = case t of
           TFun ps r =>
              do vs <- traverse (const (fresh "x")) ps
                 let xs = zip vs ps
                 pure (LLam xs (LCon c r (as ++ map (\(v, t') => LVar v t') xs)))
           _ => pure (LCon c t as)

mutual
  saturate : LowTerm -> R LowTerm
  saturate (LApp f as)
      = do f' <- saturate f
           as' <- traverse saturate as
           satApp f' as'
  saturate (LLam xs b) = mergeLam xs <$> saturate b
  saturate (LLet x t e b)
      = do e' <- saturate e >>= etaTo t
           LLet x t e' <$> saturate b
  saturate (LLetRec bs b)
      = do bs' <- traverse (\(x, t, e) => map (\e' => (x, t, e')) (saturate e >>= etaTo t)) bs
           LLetRec bs' <$> saturate b
  saturate (LCase s cons alts d)
      = do s' <- saturate s
           alts' <- traverse (\(c, xs, b) => map (\b' => (c, xs, b')) (saturate b)) alts
           d' <- traverse saturate d
           pure (LCase s' cons alts' d')
  saturate (LCaseLit s alts d)
      = do s' <- saturate s
           alts' <- traverse (\(l, b) => map (\b' => (l, b')) (saturate b)) alts
           d' <- saturate d
           pure (LCaseLit s' alts' d')
  saturate (LCon c t as)
      = do as' <- traverse saturate as
           if length as' < conArity c
              then etaCon c t as'
              else pure (LCon c t as')
  saturate t = pure t

  -- Apply a (saturated) term to (saturated) arguments
  satApp : LowTerm -> List LowTerm -> R LowTerm
  satApp f [] = pure f
  satApp (LLam xs b) as
      = -- beta: bind the arguments with lets
        do let n = min (length xs) (length as)
           let binds = zip (take n xs) (take n as)
           let rest = drop n xs
           let rest' = drop n as
           b' <- if null rest then satApp b rest' else pure (LLam rest b)
           pure (foldr (\((x, t), e), r => LLet x t e r) b' binds)
  satApp (LLet x t e b) as = LLet x t e <$> satApp b as
  satApp (LLetRec bs b) as = LLetRec bs <$> satApp b as
  satApp (LCase s cons alts d) as
      = -- push the arguments into the alternatives; non-trivial arguments are
        -- let bound first
        bindArgs as $ \vs =>
          do alts' <- traverse (\(c, xs, b) => map (\b' => (c, xs, b')) (satApp b vs)) alts
             d' <- traverse (\e => satApp e vs) d
             pure (LCase s cons alts' d')
  satApp (LCaseLit s alts d) as
      = bindArgs as $ \vs =>
          do alts' <- traverse (\(l, b) => map (\b' => (l, b')) (satApp b vs)) alts
             d' <- satApp d vs
             pure (LCaseLit s alts' d')
  satApp (LCon c t as') as = saturate (LCon c (applyTy t (length as)) (as' ++ as))
  satApp f as
      = do let n = arity (typeOf f)
           if length as < n
              then etaApp f as
              else if length as == n || n == 0
                      -- n == 0: the type of f is not known to be a function
                      then pure (LApp f as)
                      else satApp (LApp f (take n as)) (drop n as)

  -- Make a term of function type a lambda
  etaTo : LowTy -> LowTerm -> R LowTerm
  etaTo (TFun _ _) e@(LLam _ _) = pure e
  etaTo (TFun ps _) e
      = do vs <- traverse (const (fresh "x")) ps
           let xs = zip vs ps
           b <- satApp e (map (\(v, t') => LVar v t') xs)
           pure (mergeLam xs b)
  etaTo _ e = pure e

-- The number of occurrences of a variable
countVar : String -> LowTerm -> Nat
countVar x (LVar y _) = if x == y then 1 else 0
countVar x (LApp f as) = countVar x f + sum (map (countVar x) as)
countVar x (LLam _ b) = countVar x b
countVar x (LLet _ _ e b) = countVar x e + countVar x b
countVar x (LLetRec bs b) = sum (map (\(_, _, e) => countVar x e) bs) + countVar x b
countVar x (LCase s _ alts d)
    = countVar x s + sum (map (\(_, _, b) => countVar x b) alts) + maybe 0 (countVar x) d
countVar x (LCaseLit s alts d)
    = countVar x s + sum (map (countVar x . snd) alts) + countVar x d
countVar x (LCon _ _ as) = sum (map (countVar x) as)
countVar x _ = 0

-- Whether a term evaluates (the occurrences of) a variable whenever it is
-- evaluated: not under a lambda, in a case alternative or in a local function
strictIn : String -> LowTerm -> Bool
strictIn x (LVar y _) = x == y
strictIn x (LApp f as) = strictIn x f || any (strictIn x) as
strictIn x (LLet _ _ e b) = strictIn x e || strictIn x b
strictIn x (LLetRec _ b) = strictIn x b
strictIn x (LCase s _ _ _) = strictIn x s
strictIn x (LCaseLit s _ _) = strictIn x s
strictIn x (LCon _ _ as) = any (strictIn x) as
strictIn x _ = False

-- Compile time evaluation of a primitive on literals
foldPrim : String -> List LowLit -> Maybe LowLit
foldPrim p [LitInt a, LitInt b]
    = case p of
           "prim__add_Int" => Just (LitInt (prim__add_Int a b))
           "prim__sub_Int" => Just (LitInt (prim__sub_Int a b))
           "prim__mul_Int" => Just (LitInt (prim__mul_Int a b))
           "prim__div_Int" => if b == 0 then Nothing else Just (LitInt (assert_total (prim__div_Int a b)))
           "prim__mod_Int" => if b == 0 then Nothing else Just (LitInt (assert_total (prim__mod_Int a b)))
           "prim__eq_Int" => Just (LitInt (prim__eq_Int a b))
           "prim__lt_Int" => Just (LitInt (prim__lt_Int a b))
           "prim__lte_Int" => Just (LitInt (prim__lte_Int a b))
           "prim__gt_Int" => Just (LitInt (prim__gt_Int a b))
           "prim__gte_Int" => Just (LitInt (prim__gte_Int a b))
           _ => Nothing
foldPrim p [LitDouble a, LitDouble b]
    = case p of
           "prim__add_Double" => Just (LitDouble (prim__add_Double a b))
           "prim__sub_Double" => Just (LitDouble (prim__sub_Double a b))
           "prim__mul_Double" => Just (LitDouble (prim__mul_Double a b))
           "prim__div_Double" => Just (LitDouble (assert_total (prim__div_Double a b)))
           "prim__eq_Double" => Just (LitInt (prim__eq_Double a b))
           "prim__lt_Double" => Just (LitInt (prim__lt_Double a b))
           "prim__lte_Double" => Just (LitInt (prim__lte_Double a b))
           "prim__gt_Double" => Just (LitInt (prim__gt_Double a b))
           "prim__gte_Double" => Just (LitInt (prim__gte_Double a b))
           _ => Nothing
foldPrim "prim__cast_IntegerInt" [LitInteger i] = Just (LitInt (prim__cast_IntegerInt i))
foldPrim "prim__cast_IntInteger" [LitInt i] = Just (LitInteger (prim__cast_IntInteger i))
foldPrim "prim__cast_IntegerDouble" [LitInteger i] = Just (LitDouble (prim__cast_IntegerDouble i))
foldPrim "prim__cast_IntDouble" [LitInt i] = Just (LitDouble (prim__cast_IntDouble i))
foldPrim _ _ = Nothing

litOf : LowTerm -> Maybe LowLit
litOf (LLit l _) = Just l
litOf _ = Nothing

||| An application, evaluating a primitive on literals
mkApp : LowTerm -> List LowTerm -> LowTerm
mkApp f@(LPrim p t) as
    = fromMaybe (LApp f as) $
        do ls <- traverse litOf as
           l <- foldPrim p ls
           pure (LLit l (applyTy t (length as)))
mkApp f as = LApp f as

||| A case on a literal chooses an alternative
mkCaseLit : LowTerm -> List (LowLit, LowTerm) -> LowTerm -> LowTerm
mkCaseLit (LLit l _) alts d = fromMaybe d (lookup l alts)
mkCaseLit s alts d = LCaseLit s alts d

isAtomic : LowTerm -> Bool
isAtomic (LVar _ _) = True
isAtomic (LLit _ _) = True
isAtomic (LFail _) = True
isAtomic _ = False

-- The alternative for a constructor application, with its fields bound
pick : List (LowCon, List (String, LowTy), LowTerm) -> Maybe LowTerm -> LowTerm ->
       Maybe (String, LowTerm)
pick alts d (LCon c _ as)
    = case find (\(c', _, _) => conName c' == conName c) alts of
           Just (_, xs, b) =>
               if length xs == length as
                  then Just (conName c, foldr (\((x, t), a), e => LLet x t a e) b (zip xs as))
                  else Nothing
           Nothing => Just (maybe ("_fail", LFail "no match") (\b => ("_", b)) d)
pick _ _ _ = Nothing

-- Each alternative is chosen at most once (no code is duplicated, and the
-- names stay unique), unless it is atomic
once : List (String, LowTerm) -> Bool
once [] = True
once ((c, b) :: cs) = (isAtomic b || not (c `elem` map fst cs)) && once cs

mutual
  ||| A case on a constructor chooses the alternative; a case on a case
  ||| whose alternatives are constructors is a single case, such as
  |||   case (case i > n of 0 => False; _ => True) of ...
  mkCase : LowTerm -> List LowCon -> List (LowCon, List (String, LowTy), LowTerm) ->
           Maybe LowTerm -> LowTerm
  mkCase s@(LCon _ _ _) cons alts d
      = maybe (LCase s cons alts d) snd (pick alts d s)
  mkCase s cons alts d = fromMaybe (LCase s cons alts d) (caseOfCase s alts d)

  caseOfCase : LowTerm -> List (LowCon, List (String, LowTy), LowTerm) -> Maybe LowTerm ->
               Maybe LowTerm
  caseOfCase (LCaseLit s0 lalts ld) alts d
      = do picks <- traverse (pick alts d . snd) lalts
           dpick <- pick alts d ld
           if once (dpick :: picks)
              then Just (LCaseLit s0 (zip (map fst lalts) (map snd picks)) (snd dpick))
              else Nothing
  caseOfCase (LCase s0 cons0 alts0 d0) alts d
      = do picks <- traverse (\(_, _, b) => pick alts d b) alts0
           dpick <- traverse (pick alts d) d0
           if once (maybe picks (:: picks) dpick)
              then Just (LCase s0 cons0 (zipWith (\(c, xs, _), p => (c, xs, snd p)) alts0 picks)
                               (map snd dpick))
              else Nothing
  caseOfCase _ _ _ = Nothing

-- Substitute a term for a variable (all names are unique), simplifying the
-- case on a case this can make
substVar : String -> LowTerm -> LowTerm -> LowTerm
substVar x r = go
  where
    go : LowTerm -> LowTerm
    go (LVar y t) = if x == y then r else LVar y t
    go (LApp f as) = mkApp (go f) (map go as)
    go (LLam xs b) = LLam xs (go b)
    go (LLet y t e b) = LLet y t (go e) (go b)
    go (LLetRec bs b) = LLetRec (map (\(y, t, e) => (y, t, go e)) bs) (go b)
    go (LCase s cons alts d)
        = mkCase (go s) cons (map (\(c, xs, b) => (c, xs, go b)) alts) (map go d)
    go (LCaseLit s alts d) = mkCaseLit (go s) (map (\(l, b) => (l, go b)) alts) (go d)
    go (LCon c t as) = LCon c t (map go as)
    go t = t

-- Replace the (only) call  x arg  by the body of x
inlineCall : String -> LowTerm -> LowTerm -> Maybe LowTerm
inlineCall x body = go
  where
    go : LowTerm -> Maybe LowTerm
    go (LApp (LVar y t) [a]) = if x == y then Just body else LApp (LVar y t) <$> traverse go [a]
    go (LVar y t) = if x == y then Nothing else Just (LVar y t)
    go (LApp f as) = [| LApp (go f) (traverse go as) |]
    go (LLam xs b) = LLam xs <$> go b
    go (LLet y t e b) = [| LLet (pure y) (pure t) (go e) (go b) |]
    go (LLetRec bs b)
        = [| LLetRec (traverse (\(y, t, e) => (\e' => (y, t, e')) <$> go e) bs) (go b) |]
    go (LCase s cons alts d)
        = [| LCase (go s) (pure cons)
                   (traverse (\(c, xs, b) => (\b' => (c, xs, b')) <$> go b) alts)
                   (traverse go d) |]
    go (LCaseLit s alts d)
        = [| LCaseLit (go s) (traverse (\(l, b) => (\b' => (l, b')) <$> go b) alts) (go d) |]
    go (LCon c t as) = LCon c t <$> traverse go as
    go t = Just t

isUnit : LowTy -> Bool
isUnit (TData n _ _) = baseName n == "Unit"
isUnit _ = False

-- The argument lists of the calls of a function
callsOf : String -> LowTerm -> List (List LowTerm)
callsOf x (LApp (LVar y _) as) = (if x == y then [as] else []) ++ concatMap (callsOf x) as
callsOf x (LApp f as) = callsOf x f ++ concatMap (callsOf x) as
callsOf x (LLam _ b) = callsOf x b
callsOf x (LLet _ _ e b) = callsOf x e ++ callsOf x b
callsOf x (LLetRec bs b) = concatMap (\(_, _, e) => callsOf x e) bs ++ callsOf x b
callsOf x (LCase s _ alts d)
    = callsOf x s ++ concatMap (\(_, _, b) => callsOf x b) alts ++ maybe [] (callsOf x) d
callsOf x (LCaseLit s alts d) = callsOf x s ++ concatMap (callsOf x . snd) alts ++ callsOf x d
callsOf x (LCon _ _ as) = concatMap (callsOf x) as
callsOf x _ = []

-- Remove the arguments at the given positions from the calls of a function
-- (which gets the given type)
dropCallArgs : String -> LowTy -> List Nat -> LowTerm -> LowTerm
dropCallArgs x t is = go
  where
    keep : List LowTerm -> List LowTerm
    keep as = map snd (filter (\(i, _) => not (i `elem` is)) (zip [0 .. length as] as))

    go : LowTerm -> LowTerm
    go (LApp (LVar y u) as)
        = if x == y then LApp (LVar y t) (map go (keep as)) else LApp (LVar y u) (map go as)
    go (LApp f as) = LApp (go f) (map go as)
    go (LLam xs b) = LLam xs (go b)
    go (LLet y u e b) = LLet y u (go e) (go b)
    go (LLetRec bs b) = LLetRec (map (\(y, u, e) => (y, u, go e)) bs) (go b)
    go (LCase s cons alts d) = LCase (go s) cons (map (\(c, xs, b) => (c, xs, go b)) alts) (map go d)
    go (LCaseLit s alts d) = LCaseLit (go s) (map (\(l, b) => (l, go b)) alts) (go d)
    go (LCon c u as) = LCon c u (map go as)
    go tm = tm

sameAtom : LowTerm -> LowTerm -> Bool
sameAtom (LVar x _) (LVar y _) = x == y
sameAtom (LLit l _) (LLit m _) = l == m
sameAtom _ _ = False

isAtom : LowTerm -> Bool
isAtom (LVar _ _) = True
isAtom (LLit _ _) = True
isAtom _ = False

-- A parameter of a local recursive function that every recursive call passes
-- on unchanged, and that every other call gives the same variable (bound
-- outside) or literal, is that variable: the parameter is removed.  (The
-- variables of the enclosing scope that a local function uses are parameters
-- of the lifted Idris function.)
dropInvariant : LowTerm -> LowTerm
dropInvariant tm@(LLetRec [(f, TFun pts r, LLam ps body)] b)
    = let inner = callsOf f body
          outer = callsOf f b
          n = length ps
          free = map fst (freeVars b)
          bound = filter (\v => not (v `elem` free)) (varNames b)
          drops = mapMaybe (invariant inner outer bound) (zip [0 .. n] ps) in
          if null drops || not (all (\as => length as == n) (inner ++ outer))
                        || countVar f body + countVar f b /= length inner + length outer
             then tm
             else let is = map fst drops
                      keep = filter (\(i, _) => not (i `elem` is)) (zip [0 .. n] ps)
                      t' = mkFun (map (snd . snd) keep) r
                      body' = foldr (\(_, (p, a)), e => substVar p a e) body
                                    (map (\(i, a) => (i, (fromMaybe "" (map fst (getAt i ps)), a))) drops)
                      lam = if null keep then body' else LLam (map snd keep) body' in
                      if null keep then tm -- a function without parameters isn't one
                      else LLetRec [(f, t', dropCallArgs f t' is lam)] (dropCallArgs f t' is b)
  where
    invariant : List (List LowTerm) -> List (List LowTerm) -> List String ->
                (Nat, (String, LowTy)) -> Maybe (Nat, LowTerm)
    invariant inner outer bound (i, (p, _))
        = do a :: rest <- traverse (getAt i) outer
                  | [] => Nothing
             guard (isAtom a && all (sameAtom a) rest)
             guard (case a of
                         LVar y _ => not (y `elem` bound)
                         _ => True)
             inargs <- traverse (getAt i) inner
             guard (all (\x => case x of
                                    LVar y _ => y == p
                                    _ => False) inargs)
             pure (i, a)
dropInvariant tm = tm

-- Simplification after call saturation (all names are unique):
--  * a variable or literal bound by a let is substituted, and so is a value
--    which is used once, where it is evaluated anyway (low code is pure, so
--    this only changes the order of evaluation);
--  * unused functions, variables, literals and constructor applications are
--    removed (a function is never evaluated, the others cannot fail);
--  * a function with one (unit) parameter that is called once (a join point)
--    is inlined;
--  * the default alternative of a case that covers all constructors is removed;
--  * a case on a case whose alternatives are constructors is a single case.
simplify : LowTerm -> LowTerm
simplify (LLet x t e b)
    = let e' = simplify e
          b' = simplify b in
          case e' of
               LVar _ _ => substVar x e' b'
               LLit _ _ => substVar x e' b'
               _ => if countVar x b' == 1 && strictIn x b' && not (isFun t)
                       then substVar x e' b'
                    else if countVar x b' == 0 && harmless e'
                       then b'
                       else case e' of
                                 LLam [(_, pt)] body =>
                                   if isUnit pt && countVar x b' == 1
                                      then fromMaybe (LLet x t e' b') (inlineCall x body b')
                                      else LLet x t e' b'
                                 _ => LLet x t e' b'
  where
    isFun : LowTy -> Bool
    isFun (TFun _ _) = True
    isFun _ = False

    harmless : LowTerm -> Bool
    harmless (LLam _ _) = True
    harmless (LVar _ _) = True
    harmless (LLit _ _) = True
    harmless (LCon _ _ as) = all harmless as
    harmless _ = False
simplify (LLetRec bs b)
    = let bs' = map (\(x, t, e) => (x, t, simplify e)) bs
          b' = simplify b
          used = [ x | (x, _, _) <- bs',
                       countVar x b' > 0 ||
                       any (\(y, _, e) => y /= x && countVar x e > 0) bs' ] in
          if null used then b' else dropInvariant (LLetRec bs' b')
simplify (LApp f as) = mkApp (simplify f) (map simplify as)
simplify (LLam xs b) = LLam xs (simplify b)
simplify (LCase s cons alts d)
    = let alts' = map (\(c, xs, b) => (c, xs, simplify b)) alts
          complete = all (\c => c `elem` map (\(c', _, _) => c') alts') cons
          d' = if complete then Nothing else map simplify d
          s' = simplify s in
          mkCase s' cons alts' d'

simplify (LCaseLit s alts d)
    = mkCaseLit (simplify s) (map (\(l, b) => (l, simplify b)) alts) (simplify d)
simplify (LCon c t as) = LCon c t (map simplify as)
simplify t = t

-- Structural equality of simple (pure) terms
sameTerm : LowTerm -> LowTerm -> Bool
sameTerm (LVar x _) (LVar y _) = x == y
sameTerm (LLit l _) (LLit m _) = l == m
sameTerm (LPrim p _) (LPrim q _) = p == q
sameTerm (LApp f as) (LApp g bs) = sameTerm f g && sameAll as bs
  where
    sameAll : List LowTerm -> List LowTerm -> Bool
    sameAll [] [] = True
    sameAll (x :: xs) (y :: ys) = sameTerm x y && sameAll xs ys
    sameAll _ _ = False
sameTerm _ _ = False

-- A case on a literal, inside an alternative of a case on the same term:
-- the alternative is known
knownCases : List (LowTerm, LowLit) -> LowTerm -> LowTerm
knownCases known (LCaseLit s alts d)
    = let s' = knownCases known s in
          case lookupKnown s' known of
               Just l => knownCases known (fromMaybe d (lookup l alts))
               Nothing => LCaseLit s' (map (\(l, b) => (l, knownCases ((s', l) :: known) b)) alts)
                                      (knownCases known d)
  where
    lookupKnown : LowTerm -> List (LowTerm, LowLit) -> Maybe LowLit
    lookupKnown t [] = Nothing
    lookupKnown t ((u, l) :: rest) = if sameTerm t u then Just l else lookupKnown t rest
knownCases known (LApp f as) = LApp (knownCases known f) (map (knownCases known) as)
knownCases known (LLam xs b) = LLam xs (knownCases known b)
knownCases known (LLet x t e b) = LLet x t (knownCases known e) (knownCases known b)
knownCases known (LLetRec bs b)
    = LLetRec (map (\(x, t, e) => (x, t, knownCases [] e)) bs) (knownCases known b)
knownCases known (LCase s cons alts d)
    = LCase (knownCases known s) cons (map (\(c, xs, b) => (c, xs, knownCases known b)) alts)
            (map (knownCases known) d)
knownCases known (LCon c t as) = LCon c t (map (knownCases known) as)
knownCases known t = t

||| The declarations of the data types used in a term (and in its types)
export
collectDecls : LowTerm -> List LowDecl
collectDecls t0 = reverse (go [] t0)
  where
    ty : List LowDecl -> LowTy -> List LowDecl
    ty acc (TFun as r) = foldl ty (ty acc r) as
    ty acc (TData n as d)
        = if n `elem` map declName acc
             then foldl ty acc as
             else foldl ty (foldl ty (Force d :: acc) (concatMap conDeclFields (declCons d))) as
    ty acc _ = acc

    go : List LowDecl -> LowTerm -> List LowDecl
    go acc (LVar _ t) = ty acc t
    go acc (LLit _ t) = ty acc t
    go acc (LPrim _ t) = ty acc t
    go acc (LForeign _ _ t) = ty acc t
    go acc (LApp f as) = foldl go (go acc f) as
    go acc (LLam xs b) = go (foldl ty acc (map snd xs)) b
    go acc (LLet _ t e b) = go (go (ty acc t) e) b
    go acc (LLetRec bs b) = go (foldl (\a, (_, t, e) => go (ty a t) e) acc bs) b
    go acc (LCase s _ alts d)
        = let acc1 = go acc s
              acc2 = foldl (\a, (_, xs, b) => go (foldl ty a (map snd xs)) b) acc1 alts in
              maybe acc2 (go acc2) d
    go acc (LCaseLit s alts d) = go (foldl (\a, (_, b) => go a b) (go acc s) alts) d
    go acc (LCon _ t as) = foldl go (ty acc t) as
    go acc (LFail _) = acc

||| Reflect low code into a first order program
export
reflect : Low a -> LowProg
reflect l
    = let act = do b <- readBack (unLow l)
                   b' <- saturate b >>= etaTo (typeOf b)
                   pure (simplify (knownCases [] (simplify b')))
          (body, st) = runR act (MkRS [] []) in
          MkLowProg { progType = typeOf body
                    , progFree = map (\(_, n, t) => (n, t)) (free st)
                    , progDecls = collectDecls body
                    , progBody = body }

--------------------------------------------------------------------------
-- Pretty printing

-- Primitive operators are shown infix
infixOp : String -> Maybe String
infixOp p
    = case break (== '_') (unpack (fromMaybe p (stripPrefix "prim__" p))) of
           (op, '_' :: _) =>
              case pack op of
                   "add" => Just "+"
                   "sub" => Just "-"
                   "mul" => Just "*"
                   "div" => Just "`div`"
                   "mod" => Just "`mod`"
                   "lt" => Just "<"
                   "lte" => Just "<="
                   "eq" => Just "=="
                   "gte" => Just ">="
                   "gt" => Just ">"
                   "and" => Just ".&."
                   "or" => Just ".|."
                   "xor" => Just "`xor`"
                   _ => Nothing
           _ => Nothing
  where
    stripPrefix : String -> String -> Maybe String
    stripPrefix pre s = if isPrefixOf pre s then Just (pack (drop (length pre) (unpack s))) else Nothing

ppPat : String -> List String -> String
ppPat c xs
    = if c == "Nil" then "[]"
      else if c == "MkPair" then "(" ++ joinBy ", " xs ++ ")"
      else if c == "::" || c == "(::)" then (case xs of
                                   [a, b] => a ++ " :: " ++ b
                                   _ => unwords (c :: xs))
      else unwords (c :: xs)

ppLit : LowLit -> String
ppLit = show

nl : Nat -> String
nl n = "\n" ++ pack (replicate n ' ')

par : Bool -> String -> String
par True s = "(" ++ s ++ ")"
par False s = s

-- precedence: 0 top, 10 argument
ppT : Nat -> Nat -> LowTerm -> String
ppT ind p (LVar x _) = x
ppT ind p (LLit l _) = ppLit l
ppT ind p (LPrim s _) = s
ppT ind p (LForeign _ c _) = "ffi:" ++ c
ppT ind p (LApp (LPrim op t) [a, b])
    = case infixOp op of
           Just o => par (p > 5) $ ppT ind 6 a ++ " " ++ o ++ " " ++ ppT ind 6 b
           Nothing => par (p > 9) $ unwords (op :: map (ppT ind 10) [a, b])
ppT ind p (LApp f as) = par (p > 9) $ unwords (ppT ind 10 f :: map (ppT ind 10) as)
ppT ind p (LLam xs b)
    = par (p > 0) $ "\\" ++ joinBy ", " [ x ++ " : " ++ show t | (x, t) <- xs ] ++ " =>" ++
                    nl (ind + 2) ++ ppT (ind + 2) 0 b
ppT ind p (LLet x t e b)
    = par (p > 0) $ "let " ++ x ++ " : " ++ show t ++ " = " ++ ppT (ind + 4) 0 e ++ nl ind ++
                    "in " ++ ppT (ind + 3) 0 b
ppT ind p (LLetRec bs b)
    = par (p > 0) $ "letrec" ++
                    concatMap (\(x, t, e) => nl (ind + 2) ++ x ++ " : " ++ show t ++ " = " ++
                                             ppT (ind + 4) 0 e) bs ++
                    nl ind ++ "in " ++ ppT (ind + 3) 0 b
ppT ind p (LCase s _ alts d)
    = par (p > 0) $ "case " ++ ppT ind 0 s ++ " of" ++
                    concatMap (\(c, xs, b) => nl (ind + 2) ++ ppPat (baseName (conName c)) (map fst xs) ++
                                              " => " ++ ppT (ind + 4) 0 b) alts ++
                    maybe "" (\e => nl (ind + 2) ++ "_ => " ++ ppT (ind + 4) 0 e) d
ppT ind p (LCaseLit s alts d)
    = par (p > 0) $ "case " ++ ppT ind 0 s ++ " of" ++
                    concatMap (\(l, b) => nl (ind + 2) ++ ppLit l ++ " => " ++ ppT (ind + 4) 0 b) alts ++
                    nl (ind + 2) ++ "_ => " ++ ppT (ind + 4) 0 d
ppT ind p (LCon c _ as)
    = case (baseName (conName c), as) of
           ("MkPair", [a, b]) => "(" ++ ppT ind 0 a ++ ", " ++ ppT ind 0 b ++ ")"
           ("::", [a, b]) => par (p > 4) $ ppT ind 5 a ++ " :: " ++ ppT ind 4 b
           ("(::)", [a, b]) => par (p > 4) $ ppT ind 5 a ++ " :: " ++ ppT ind 4 b
           ("Nil", []) => "[]"
           (n, []) => n
           (n, _) => par (p > 9) $ unwords (n :: map (ppT ind 10) as)
ppT ind p (LFail m) = par (p > 9) $ "fail " ++ show m

export
lowPrettyTerm : LowTerm -> String
lowPrettyTerm = ppT 0 0

export
lowPretty : LowProg -> String
lowPretty p
    = unlines $ [ "-- type: " ++ show (progType p) ] ++
                [ "-- free: " ++ x ++ " : " ++ show t | (x, t) <- progFree p ] ++
                [ "-- " ++ show d | d <- progDecls p ] ++
                [ lowPrettyTerm (progBody p) ]

--------------------------------------------------------------------------
-- The code generation monad (let insertion), as in Language.Staged, for
-- low code

||| Code generators in continuation passing style, so that they can insert
||| let bindings around the low code they generate
public export
record Gen a where
  constructor MkGen
  unGen : {0 r : Type} -> (a -> Low r) -> Low r

public export
Functor Gen where
  map f (MkGen g) = MkGen (\k => g (k . f))

public export
Applicative Gen where
  pure x = MkGen (\k => k x)
  MkGen f <*> MkGen x = MkGen (\k => f (\f' => x (\x' => k (f' x'))))

public export
Monad Gen where
  MkGen x >>= f = MkGen (\k => x (\x' => unGen (f x') k))

||| Run a code generator
public export
runGen : Gen (Low a) -> Low a
runGen (MkGen g) = g id

||| A let around the code of the continuation: let n = e in ...
public export
genLetNamed : LowRep a => String -> Low a -> (Low a -> Low b) -> Low b
genLetNamed @{r} n c f = MkLow (HLet n (Just (lowTyRep r)) (unLow c) (\x => unLow (f (MkLow x))))

public export
genLet : LowRep a => Low a -> (Low a -> Low b) -> Low b
genLet = genLetNamed "x"

||| Bind the code to a variable, so it is evaluated once, and return (code
||| for) the variable
public export
genNamed : LowRep a => String -> Low a -> Gen (Low a)
genNamed n c = MkGen (\k => genLetNamed n c k)

public export
gen : LowRep a => Low a -> Gen (Low a)
gen = genNamed "x"

||| A recursive definition (a function): the generator gets (code for) the
||| variable being defined
public export
genRecNamed : LowRep a => String -> (Low a -> Low a) -> Gen (Low a)
genRecNamed @{r} n f
    = MkGen (\k => MkLow (HLetRec [(n, lowTyRep r)]
                                  (\vs => case vs of
                                               [v] => ([unLow (f (MkLow v))], unLow (k (MkLow v)))
                                               _ => ([], HFail "genRec"))))

public export
genRec : LowRep a => (Low a -> Low a) -> Gen (Low a)
genRec = genRecNamed "x"

||| Name the variable bound by the let (or recursive let) c, and the
||| parameters of the function it binds (as many as there are names), in the
||| generated code
public export
named : String -> List String -> Low a -> Low a
named n xs c
    = case unLow c of
           HLet _ t e b => MkLow (HLet n t (params xs e) b)
           HLetRec [(_, t)] f =>
               MkLow (HLetRec [(n, t)] (\vs => case f vs of
                                                    ([e], b) => ([params xs e], b)
                                                    r => r))
           _ => c
  where
    params : List String -> LowExp -> LowExp
    params (y :: ys) (HLam _ t f) = HLam y t (params ys . f)
    params _ e = e

--------------------------------------------------------------------------
-- Compile time values as low code

public export
lowInt : Int -> Low Int
lowInt i = MkLow (HLit (LitInt i) TInt)

public export
lowInteger : Integer -> Low Integer
lowInteger i = MkLow (HLit (LitInteger i) TInteger)

public export
lowDouble : Double -> Low Double
lowDouble d = MkLow (HLit (LitDouble d) TDouble)

public export
lowChar : Char -> Low Char
lowChar c = MkLow (HLit (LitChar c) TChar)

public export
lowString : String -> Low String
lowString s = MkLow (HLit (LitString s) TString)
